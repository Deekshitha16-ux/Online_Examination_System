{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start examination backend",
			"type": "shell",
			"command": "npm",
			"args": ["start"],
			"options": {
				"cwd": "${workspaceFolder}\\Online-Examination-System-MERN-Stack-main\\Backend",
				"env": {
					"PORT": "5000",
					"FRONTEND_URL": "http://localhost:3001"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start examination frontend",
			"type": "shell",
			"command": "node",
			"args": ["node_modules\\react-scripts\\scripts\\start.js"],
			"options": {
				"cwd": "${workspaceFolder}\\Online-Examination-System-MERN-Stack-main\\Frontend",
				"env": {
					"PORT": "3001",
					"HOST": "0.0.0.0",
					"REACT_APP_API_BASE": "http://localhost:5000"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}